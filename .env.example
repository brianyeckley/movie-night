# Copy to `.env` in the project root and fill in. `.env` is gitignored and is
# read by Docker Compose to substitute the ${VARS} in docker-compose.yml, so it
# persists across restarts — it is a file on disk, not a shell export.
#
# After changing anything here, run `docker compose up -d` to recreate the
# container. Watchtower clones the running container's existing environment when
# it pulls a new image, so it will not pick up a variable added since the
# container was last created.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signing key for session cookies. The app refuses to start in production
# without it rather than fall back to a key committed to the repository.
# Generate with: openssl rand -base64 32
# Changing this invalidates every existing session (everyone gets logged out).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Cloudflare Tunnel token for the `tunnel` service.
TUNNEL_TOKEN=

# Public URL, used in Discord notification links.
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Host directory mounted to /app/data to persist the SQLite database.
DATA_DIR=./data

# Ownership of the container process. Match the host user that owns DATA_DIR.
PUID=0
PGID=0

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------

# Discord webhook for round notifications and vote reminders. Notifications are
# skipped with a warning when unset.
DISCORD_WEBHOOK_URL=

# Shared secret for /api/cron/remind-votes. The endpoint rejects every request
# when this is unset, so reminders stop rather than the route being left open.
CRON_SECRET=

# Cron schedule for the reminder container. Defaults to noon daily.
CRON_SCHEDULE=0 12 * * *

# OMDb API key. Movie metadata falls back to Wikidata when absent.
OMDB_API_KEY=

# Only used by the one-off spreadsheet import scripts.
GOOGLE_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# Seeding — only read the first time the database is created
# ---------------------------------------------------------------------------

ADMIN_USERNAME=Brian
ADMIN_PASSWORD=
STEW_PASSWORD=
NICK_PASSWORD=

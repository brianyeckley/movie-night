// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique // "brian", "stew", "nick"
  name         String             // "Brian", "Stew", "Nick"
  passwordHash String     @default("")
  role         String     @default("USER") // "ADMIN" or "USER"
  isApproved   Boolean    @default(false)
  votes        WeekVote[]
}

model Category {
  id            String           @id @default(uuid())
  name          String           @unique
  isThemed      Boolean          @default(false)
  isActive      Boolean          @default(true) // For archiving old theme categories
  parentId      String?
  parent        Category?        @relation("Subcategories", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories Category[]       @relation("Subcategories")
  movies        Movie[]
  weeks         MovieNightWeek[] @relation("ThemeCategory")
  createdAt     DateTime         @default(now())
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique // "Horror", "Sci-Fi", "Action", "Comedy", "Crime", "Schlock", "Martial Arts", "Fantasy"
  movies    Movie[]
  createdAt DateTime @default(now())
}

model Movie {
  id             String   @id @default(uuid())
  title          String
  imdbUrl        String?
  trailerUrl     String?
  year           Int?
  director       String?
  stars          String?
  runtime        String?
  plot           String?
  posterUrl      String?
  imdbRating     String?
  watched        Boolean  @default(false)
  physical4K     Boolean  @default(false)
  physicalBluRay Boolean  @default(false)
  physicalDvd    Boolean  @default(false)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  genres         Genre[]
  createdAt      DateTime @default(now())
}

model MovieNightWeek {
  id                    String     @id @default(uuid())
  weekNumber            Int        @unique
  // Statuses are defined by the WeekStatus union in src/lib/rounds.ts, which
  // also maps each one to the round that is open for voting.
  status                String     @default("CATEGORY_VOTING")
  themeCategoryId       String?
  themeCategory         Category?  @relation("ThemeCategory", fields: [themeCategoryId], references: [id])
  selectedCategoryId    String?    // Winning category from Round 1
  selectedSubcategoryId String?    // Winning subcategory from Round 2 (if applicable)
  winningMovieId        String?    // Final winner
  isRandomlyChosen      Boolean    @default(false)
  isInPerson            Boolean    @default(false)
  createdAt             DateTime   @default(now())
  closedAt              DateTime?
  votes                 WeekVote[]
}

model WeekVote {
  id         String         @id @default(uuid())
  weekId     String
  week       MovieNightWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Round codes are defined by the RoundCode union in src/lib/rounds.ts.
  round      String
  targetId   String         // Can represent Category ID, Subcategory ID, or Movie ID
  createdAt  DateTime       @default(now())

  // Every read filters on the week plus the round, and tallying additionally
  // groups by user, so both shapes are indexed rather than table-scanned.
  @@index([weekId, round])
  @@index([weekId, userId, round])
  // A user cannot cast the same vote twice in a round. Per-round limits are
  // still enforced in the actions; this is the backstop against double submits.
  @@unique([weekId, userId, round, targetId])
}
